# InsideTheIOM Studio — Environment Configuration
# Copy this file to .env.local and fill in your values.
# These variables are server-side only and are NEVER exposed to the browser.

# Phase 2–4: Google Apps Script Backend
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_SECRET=replace-with-a-strong-random-secret

# Phase 5: Server-Side OAuth Token Encryption (32+ random characters or 64 hex chars)
STUDIO_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters-for-aes-256-gcm

# Phase 5: Meta / Instagram Graph API OAuth
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback

# Phase 5: TikTok Login Kit & Content Posting API OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/integrations/tiktok/callback

# Automatic Photographic Background Search (Optional Pexels API Key — free at pexels.com/api)
PEXELS_API_KEY=
